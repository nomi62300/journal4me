# Supabase — the publishable key is safe in client JS; RLS is the security boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_ and never commit a real value.
# Bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Web push (VAPID). Public key is exposed to the client; private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
