# Supabase — the publishable key is safe in client JS; RLS is the security boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_ and never commit a real value.
# Bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Web push (VAPID). Public key is exposed to the client; private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret Postgres sends in the x-push-queue-secret header when it calls
# /api/push/process-queue via pg_net — proves the call came from this
# database's cron/trigger, not an arbitrary internet request. Set the SAME
# value here and via `alter database ... set app.push_queue_secret = '...'`
# on whichever project this app points at (see the push_notification_queue
# migration's comment — supabase/config.toml does not reach a hosted project).
PUSH_QUEUE_SECRET=
